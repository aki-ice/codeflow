# ========== 需要手动配置的部分（复制到 .env，docker compose 会读取） ==========

# JWT 签名密钥（所有服务共用同一个）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret-at-least-32-bytes-long

# 服务间内部调用令牌（user-service / project-service 共用）
INTERNAL_TOKEN=dev-internal-token

# ===== GitHub 集成（Phase 6，手动配置） =====
# GitHub Webhook HMAC 验签密钥：与 GitHub 仓库 Webhook 设置中的 Secret 保持一致
# 留空则跳过验签（仅限本地开发）
GITHUB_WEBHOOK_SECRET=
# GitHub Personal Access Token：用于同步 Pull Request（repo 权限）
GITHUB_TOKEN=

# ===== LLM / AI（Phase 13，可选；留空用 Mock 降级） =====
# OpenAI / DeepSeek / Ollama 等任一 OpenAI 兼容服务的 Key
LLM_API_KEY=
# DeepSeek: https://api.deepseek.com/v1，本地 Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
# DeepSeek: deepseek-chat
LLM_MODEL=gpt-4o-mini

# ===== 本地开发（docker compose 内自动注入，无需修改） =====
# user-service:   DATABASE_URL=postgresql+asyncpg://codeflow:codeflow@postgres:5432/codeflow_users
# project-service: DATABASE_URL=postgresql+asyncpg://codeflow:codeflow@postgres:5432/codeflow_projects
# notification-service: DATABASE_URL=postgresql+asyncpg://codeflow:codeflow@postgres:5432/codeflow_notifications
# 所有服务: REDIS_URL=redis://redis:6379/0  KAFKA_BOOTSTRAP_SERVERS=kafka:29092
